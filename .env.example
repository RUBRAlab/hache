# Webhook de n8n que recibe los leads del formulario de #contacto.
# Vive en .env.local para desarrollo y en Vercel -> Settings -> Environment
# Variables -> Production para el sitio publicado.
# Si no esta definida, src/site.js usa el webhook de produccion por defecto.
VITE_N8N_WEBHOOK_URL="https://tu-instancia-n8n/webhook/hache-contacto"
